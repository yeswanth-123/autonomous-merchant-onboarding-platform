# Copy to .env (setup.sh does this). All values optional; defaults shown.
# ONB_WEBHOOK_SECRET=dev-webhook-secret
# ONB_ALLOW_DEFAULT_TOKENS=1      # 1 = the public demo tokens below work; set 0 outside a demo
# ONB_TOKEN_REVIEWER=reviewer-token
# ONB_TOKEN_ADMIN=admin-token
# ONB_TIMEOUT_SECONDS=30        # verification deadline (use 8 to see timeouts quickly)
# ONB_EXPIRY_SECONDS=604800     # NEEDS_INFO expiry (7 days)
# ONB_DEMO_STEP_SECONDS=0       # demo pacing: each state lasts about this many seconds (0 = full speed)
# ONB_MASTER_KEY=               # document master key (urlsafe-base64, 32 bytes); auto-generated into data/.master_key if unset
# ONB_FERNET_KEY=               # field-encryption key; auto-generated into data/.fernet_key if unset
# ONB_SECURE_COOKIES=0          # set 1 when served over HTTPS
# ONB_SEED_DEMO_USERS=1         # setup.sh creates the demo accounts (dev only)
# ONB_DATA_DIR=./data           # database, encrypted uploads, keys
# ONB_DB_URL=sqlite:///./data/onboarding.db
# ONB_MAX_UPLOAD_BYTES=5242880
# ONB_RULES_FILE=./rules.yaml   # workflow rules (checks, timeouts, retention ...)
# ONB_DEMO_PASSWORD=Demo-Passw0rd!   # password of the seeded demo accounts (dev only)
# ONB_API_URL=http://127.0.0.1:8000  # where providers send callbacks (run.sh sets it from API_PORT)
# ONB_MOCK_URL=http://127.0.0.1:8001 # where the mock providers live (run.sh sets it from MOCK_PORT)
# API_PORT=8000
# MOCK_PORT=8001
